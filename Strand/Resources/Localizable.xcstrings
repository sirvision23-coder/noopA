    "Long press to show or hide your heart rate.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "بە ماوەیەکی درێژ دەستی پێوە بنێ بۆ پیشاندان یان شاردنەوەی لێدانی دڵت."}}, "ckb": {"stringUnit": {"state": "translated", "value": "بە ماوەیەکی درێژ دەستی پێوە بنێ بۆ پیشاندان یان شاردنەوەی لێدانی دڵت."}}}},
    "Longer ranges unlock as more history builds.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "ماوە درێژترەکان کراوە دەبنەوە کاتێک مێژووی زیاتر دروست دەبێت."}}, "ckb": {"stringUnit": {"state": "translated", "value": "ماوە درێژترەکان کراوە دەبنەوە کاتێک مێژووی زیاتر دروست دەبێت."}}}},
    "Longest: %lld days": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "درێژترین: %lld ڕۆژ"}}, "ckb": {"stringUnit": {"state": "translated", "value": "درێژترین: %lld ڕۆژ"}}}},
    "Longest: 1 day": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "درێژترین: ١ ڕۆژ"}}, "ckb": {"stringUnit": {"state": "translated", "value": "درێژترین: ١ ڕۆژ"}}}},
    "Looks like a workout": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "وەک ڕاهێنانێک دەچێت"}}, "ckb": {"stringUnit": {"state": "translated", "value": "وەک ڕاهێنانێک دەچێت"}}}},
    "Looks like a workout around %@–%@ (avg HR %lld, %lld min). Save it?": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "وەک ڕاهێنانێک دەچێت لە نزیکەی %@–%@ (تێکڕای لێدانی دڵ %lld، %lld خولەک). پاشەکەوت بکرێت؟"}}, "ckb": {"stringUnit": {"state": "translated", "value": "وەک ڕاهێنانێک دەچێت لە نزیکەی %@–%@ (تێکڕای لێدانی دڵ %lld، %lld خولەک). پاشەکەوت بکرێت؟"}}}},
    "Looks like a workout on %@ around %@–%@ (avg HR %lld, %lld min). Save it?": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "وەک ڕاهێنانێک دەچێت لە %@ نزیکەی %@–%@ (تێکڕای لێدانی دڵ %lld، %lld خولەک). پاشەکەوت بکرێت؟"}}, "ckb": {"stringUnit": {"state": "translated", "value": "وەک ڕاهێنانێک دەچێت لە %@ نزیکەی %@–%@ (تێکڕای لێدانی دڵ %lld، %lld خولەک). پاشەکەوت بکرێت؟"}}}},
    "Looks like a workout yesterday around %@–%@ (avg HR %lld, %lld min). Save it?": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "وەک ڕاهێنانێک دەچێت دوێنێ نزیکەی %@–%@ (تێکڕای لێدانی دڵ %lld، %lld خولەک). پاشەکەوت بکرێت؟"}}, "ckb": {"stringUnit": {"state": "translated", "value": "وەک ڕاهێنانێک دەچێت دوێنێ نزیکەی %@–%@ (تێکڕای لێدانی دڵ %lld، %lld خولەک). پاشەکەوت بکرێت؟"}}}},
