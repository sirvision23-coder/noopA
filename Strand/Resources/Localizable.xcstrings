    "KCAL": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "کیلۆکالۆری"}}, "ckb": {"stringUnit": {"state": "translated", "value": "کیلۆکالۆری"}}}},
    "KEY METRICS": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "پێوەرە سەرەکییەکان"}}, "ckb": {"stringUnit": {"state": "translated", "value": "پێوەرە سەرەکییەکان"}}}},
    "Keep it within about a metre of %@.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "لە ماوەی نزیکەی مەترێکدا لە %@ بیهێڵەرەوە."}}, "ckb": {"stringUnit": {"state": "translated", "value": "لە ماوەی نزیکەی مەترێکدا لە %@ بیهێڵەرەوە."}}}},
    "Keep last exports": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "دوایین هەناردەکان بهێڵەرەوە"}}, "ckb": {"stringUnit": {"state": "translated", "value": "دوایین هەناردەکان بهێڵەرەوە"}}}},
    "Keep last snapshots": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "دوایین وێنە هەڵگیراوەکان بهێڵەرەوە"}}, "ckb": {"stringUnit": {"state": "translated", "value": "دوایین وێنە هەڵگیراوەکان بهێڵەرەوە"}}}},
    "Keep screen on during a workout": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "شاشەکە ڕووناک بهێڵەرەوە لە کاتی ڕاهێناندا"}}, "ckb": {"stringUnit": {"state": "translated", "value": "شاشەکە ڕووناک بهێڵەرەوە لە کاتی ڕاهێناندا"}}}},
    "Keep the Oura app instead (import a file)": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "ئەپی Oura بهێڵەرەوە (فایلێک هاوردە بکە)"}}, "ckb": {"stringUnit": {"state": "translated", "value": "ئەپی Oura بهێڵەرەوە (فایلێک هاوردە بکە)"}}}},
    "Keep the Oura app instead, import a file": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "ئەپی Oura بهێڵەرەوە و فایلێک هاوردە بکە"}}, "ckb": {"stringUnit": {"state": "translated", "value": "ئەپی Oura بهێڵەرەوە و فایلێک هاوردە بکە"}}}},
    "Keep the ring on the charger or on your finger so it stays awake.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "ئەڵقەکە لەسەر شەحنکەر یان لەسەر پەنجەت بهێڵەرەوە بۆ ئەوەی بەئاگا بمێنێتەوە."}}, "ckb": {"stringUnit": {"state": "translated", "value": "ئەڵقەکە لەسەر شەحنکەر یان لەسەر پەنجەت بهێڵەرەوە بۆ ئەوەی بەئاگا بمێنێتەوە."}}}},
    "Keep your bloods, BP and body numbers private, on %@.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "پشکنینی خوێن، پەستانی خوێن و ژمارەکانی جەستەت تایبەت بهێڵەرەوە، لەسەر %@."}}, "ckb": {"stringUnit": {"state": "translated", "value": "پشکنینی خوێن، پەستانی خوێن و ژمارەکانی جەستەت تایبەت بهێڵەرەوە، لەسەر %@."}}}},
    "Keep your own numbers here": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "ژمارەکانی خۆت لێرە بهێڵەرەوە"}}, "ckb": {"stringUnit": {"state": "translated", "value": "ژمارەکانی خۆت لێرە بهێڵەرەوە"}}}},
    "Keeps the detailed beat-to-beat heart-rate stream running all day and night, not just while a live screen is open, so NOOP captures much more for overnight HRV, recovery and sleep. Uses more battery: your strap streams heart rate continuously while connected.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "ڕەوەندی وردی لێدانی دڵی لێدان بە لێدان بەردەوام دەهێڵێتەوە بە ڕۆژ و شەو، نەک تەنیا کاتێک شاشەی ڕاستەوخۆ کراوەیە، بۆیە NOOP زۆر زیاتر دەگرێت بۆ گۆڕانی لێدانی دڵی شەوانە، چاکبوونەوە و خەو. باتری زیاتر دەبات: بەندەکەت بەردەوام لێدانی دڵ دەنێرێت کاتێک پەیوەستە."}}, "ckb": {"stringUnit": {"state": "translated", "value": "ڕەوەندی وردی لێدانی دڵی لێدان بە لێدان بەردەوام دەهێڵێتەوە بە ڕۆژ و شەو، نەک تەنیا کاتێک شاشەی ڕاستەوخۆ کراوەیە، بۆیە NOOP زۆر زیاتر دەگرێت بۆ گۆڕانی لێدانی دڵی شەوانە، چاکبوونەوە و خەو. باتری زیاتر دەبات: بەندەکەت بەردەوام لێدانی دڵ دەنێرێت کاتێک پەیوەستە."}}}},
