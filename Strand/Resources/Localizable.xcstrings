    "Set %lld of %lld": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "خولی %lld لە %lld"}}, "ckb": {"stringUnit": {"state": "translated", "value": "خولی %lld لە %lld"}}}},
    "session RPE %@": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "RPEی دانیشتن %@"}}, "ckb": {"stringUnit": {"state": "translated", "value": "RPEی دانیشتن %@"}}}},
