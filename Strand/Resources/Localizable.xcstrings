    "Save this route as a standard file you can import into Strava, Garmin Connect, and other apps.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "ئەم ڕێگایە وەک فایلێکی ستاندارد پاشەکەوت بکە کە بتوانیت بیخەیتە ناو Strava، Garmin Connect و ئەپەکانی تر."}}, "ckb": {"stringUnit": {"state": "translated", "value": "ئەم ڕێگایە وەک فایلێکی ستاندارد پاشەکەوت بکە کە بتوانیت بیخەیتە ناو Strava، Garmin Connect و ئەپەکانی تر."}}}},
    "Active calories": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "کالۆریی چالاک"}}, "ckb": {"stringUnit": {"state": "translated", "value": "کالۆریی چالاک"}}}},
