    "Unlock WHOOP 5/MG deep data (R22)": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "کردنەوەی داتای قووڵی WHOOP 5/MG (R22)"}}, "ckb": {"stringUnit": {"state": "translated", "value": "کردنەوەی داتای قووڵی WHOOP 5/MG (R22)"}}}},
    "Sharpens your VO₂max": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "زۆرترین ئۆکسجینی VO₂ی تۆ وردتر دەکات"}}, "ckb": {"stringUnit": {"state": "translated", "value": "زۆرترین ئۆکسجینی VO₂ی تۆ وردتر دەکات"}}}},
    "Unread. %@. %@": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "نەخوێندراوە. %@. %@"}}, "ckb": {"stringUnit": {"state": "translated", "value": "نەخوێندراوە. %@. %@"}}}},
    "Unvalidated instrumentation, not a medical measurement and not a diagnosis.": {"comment": "MEDICAL SAFETY COPY — needs a native speaker, not a machine translation. Deliberately left untranslated: a disclaimer that drifts in meaning is worse than one shown in English. Until a human translates it, the absent localizations make the runtime fall back to this English source text, which is correct and complete. Keep every element when translating: not a medical device, not a diagnosis, and the instruction to see a doctor.", "shouldTranslate": false},
    "Updated weekly": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "هەفتانە نوێ دەبێتەوە"}}, "ckb": {"stringUnit": {"state": "translated", "value": "هەفتانە نوێ دەبێتەوە"}}}},
    "Updates": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "نوێکردنەوەکان"}}, "ckb": {"stringUnit": {"state": "translated", "value": "نوێکردنەوەکان"}}}},
