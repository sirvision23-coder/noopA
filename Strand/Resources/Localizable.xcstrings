    "Get your ring ready": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "ئەڵقەکەت ئامادە بکە"}}, "ckb": {"stringUnit": {"state": "translated", "value": "ئەڵقەکەت ئامادە بکە"}}}},
    "Getting your devices ready": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "ئامێرەکانت ئامادە دەکرێن"}}, "ckb": {"stringUnit": {"state": "translated", "value": "ئامێرەکانت ئامادە دەکرێن"}}}},
