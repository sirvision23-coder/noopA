    "Delete this program?": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "ئەم پڕۆگرامە بسڕدرێتەوە؟"}}, "ckb": {"stringUnit": {"state": "translated", "value": "ئەم پڕۆگرامە بسڕدرێتەوە؟"}}}},
    "Sessions you already logged from it are kept.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "ئەو دانیشتنانەی پێشتر پێیەوە تۆمارت کردوون دەمێننەوە."}}, "ckb": {"stringUnit": {"state": "translated", "value": "ئەو دانیشتنانەی پێشتر پێیەوە تۆمارت کردوون دەمێننەوە."}}}},
