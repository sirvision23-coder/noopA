    "Learning your baseline, %lld of %lld nights.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "ئاستی بنەڕەتت فێردەبێت، %lld لە %lld شەو."}}, "ckb": {"stringUnit": {"state": "translated", "value": "ئاستی بنەڕەتت فێردەبێت، %lld لە %lld شەو."}}}},
