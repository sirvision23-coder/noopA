    "Mon": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "دووشەممە"}}, "ckb": {"stringUnit": {"state": "translated", "value": "دووشەممە"}}}},
    "Monday": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "دووشەممە"}}, "ckb": {"stringUnit": {"state": "translated", "value": "دووشەممە"}}}},
    "Mood": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "دۆخی دەروونی"}}, "ckb": {"stringUnit": {"state": "translated", "value": "دۆخی دەروونی"}}}},
    "Mood, alongside your body's signals": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "دۆخی دەروونی، لەگەڵ ئاماژەکانی جەستەت"}}, "ckb": {"stringUnit": {"state": "translated", "value": "دۆخی دەروونی، لەگەڵ ئاماژەکانی جەستەت"}}}},
