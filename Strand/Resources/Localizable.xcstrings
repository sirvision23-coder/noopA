    "Import Apple Health export": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "هاوردەکردنی داتای Apple Health"}}, "ckb": {"stringUnit": {"state": "translated", "value": "هاوردەکردنی داتای Apple Health"}}}},
