    "Trailing window": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "پەنجەرەی کۆتایی"}}, "ckb": {"stringUnit": {"state": "translated", "value": "پەنجەرەی کۆتایی"}}}},
    "Train by feel. The strap buzzes so you don't have to watch a screen.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "بە هەست ڕاهێنان بکە. بەند دەلەرزێت بۆ ئەوەی پێویست نەکات سەیری شاشە بکەیت."}}, "ckb": {"stringUnit": {"state": "translated", "value": "بە هەست ڕاهێنان بکە. بەند دەلەرزێت بۆ ئەوەی پێویست نەکات سەیری شاشە بکەیت."}}}},
    "Training load": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "بارگرانیی ڕاهێنان"}}, "ckb": {"stringUnit": {"state": "translated", "value": "بارگرانیی ڕاهێنان"}}}},
    "Training variety": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "جۆراوجۆریی ڕاهێنان"}}, "ckb": {"stringUnit": {"state": "translated", "value": "جۆراوجۆریی ڕاهێنان"}}}},
    "Treadmill, indoor bike, rower or cross-trainer (Bluetooth FTMS)": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "ڕێگای پیاسە، پاسکیلی ناوەوە، قایق یان ئامێری هاوتەریب (Bluetooth FTMS)"}}, "ckb": {"stringUnit": {"state": "translated", "value": "ڕێگای پیاسە، پاسکیلی ناوەوە، قایق یان ئامێری هاوتەریب (Bluetooth FTMS)"}}}},
