    "Choose which cards show and reorder them": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "هەڵبژێرە کام کارت پیشان بدرێن و ڕیزیان بکە"}}, "ckb": {"stringUnit": {"state": "translated", "value": "هەڵبژێرە کام کارت پیشان بدرێن و ڕیزیان بکە"}}}},
    "Choose which tiles show on your Control Center and reorder them with the arrows.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "هەڵبژێرە کام چوارگۆشە لەسەر ناوەندی کۆنتڕۆڵەکەت پیشان بدرێن و بە تیرەکان ڕیزیان بکە."}}, "ckb": {"stringUnit": {"state": "translated", "value": "هەڵبژێرە کام چوارگۆشە لەسەر ناوەندی کۆنتڕۆڵەکەت پیشان بدرێن و بە تیرەکان ڕیزیان بکە."}}}},
