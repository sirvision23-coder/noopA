    "Nothing to export": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "هیچ شتێک نییە بۆ هەناردەکردن"}}, "ckb": {"stringUnit": {"state": "translated", "value": "هیچ شتێک نییە بۆ هەناردەکردن"}}}},
    "Nothing to fuse yet": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "هێشتا هیچ شتێک نییە بۆ تێکەڵکردن"}}, "ckb": {"stringUnit": {"state": "translated", "value": "هێشتا هیچ شتێک نییە بۆ تێکەڵکردن"}}}},
