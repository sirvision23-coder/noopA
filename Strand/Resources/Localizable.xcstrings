    "Open journal": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "کردنەوەی ڕۆژنووس"}}, "ckb": {"stringUnit": {"state": "translated", "value": "کردنەوەی ڕۆژنووس"}}}},
    "Open live view": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "کردنەوەی بینینی ڕاستەوخۆ"}}, "ckb": {"stringUnit": {"state": "translated", "value": "کردنەوەی بینینی ڕاستەوخۆ"}}}},
    "Open the official Oura app and remove this ring (Oura calls it \"factory reset\" or \"unpair and reset\"). This wipes the ring's owner so NOOP can take it over.": {},
    "Open-source BLE reverse-engineering work. Thank you.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Open-source BLE reverse-engineering work. Thank you."}}}},
    "Opens the Apple Watch setup and Health permission": {},
    "Opens the Devices screen, where you pair and switch bands.": {},
    "Opens the GitHub releases page in your browser. NOOP itself makes no network connections, the macOS sandbox has no network entitlement.": {"extractionState": "stale", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Opens the GitHub releases page in your browser. NOOP itself makes no network connections, the macOS sandbox has no network entitlement."}}}},
    "Opens the full-day heart rate timeline": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "هێڵی کاتی لێدانی دڵی ڕۆژی تەواو دەکاتەوە"}}, "ckb": {"stringUnit": {"state": "translated", "value": "هێڵی کاتی لێدانی دڵی ڕۆژی تەواو دەکاتەوە"}}}},
