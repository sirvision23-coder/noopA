    "Intensity minutes": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "خولەکەکانی توندی"}}, "ckb": {"stringUnit": {"state": "translated", "value": "خولەکەکانی توندی"}}}},
    "Interrogate what affects what.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "بپرسە چی کاریگەری لەسەر چی هەیە."}}, "ckb": {"stringUnit": {"state": "translated", "value": "بپرسە چی کاریگەری لەسەر چی هەیە."}}}},
