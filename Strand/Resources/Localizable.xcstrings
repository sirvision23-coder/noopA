    "Full strap stream is active.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "ڕەوەندی تەواوی بەند چالاکە."}}, "ckb": {"stringUnit": {"state": "translated", "value": "ڕەوەندی تەواوی بەند چالاکە."}}}},
    "Full sweep · ~13 min": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "گەڕانی تەواو · نزیکەی ١٣ خولەک"}}, "ckb": {"stringUnit": {"state": "translated", "value": "گەڕانی تەواو · نزیکەی ١٣ خولەک"}}}},
    "Fully quit and reopen NOOP to load it.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "NOOP بە تەواوی دابخە و دووبارە بیکەرەوە بۆ بارکردنی."}}, "ckb": {"stringUnit": {"state": "translated", "value": "NOOP بە تەواوی دابخە و دووبارە بیکەرەوە بۆ بارکردنی."}}}},
    "Functional strength": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "هێزی کارا"}}, "ckb": {"stringUnit": {"state": "translated", "value": "هێزی کارا"}}}},
    "Fused on %@. Nothing leaves it: no account, no cloud.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "لەسەر %@ تێکەڵ کراوە. هیچ شتێک ناچێتە دەرەوە: بێ هەژمار، بێ کڵاود."}}, "ckb": {"stringUnit": {"state": "translated", "value": "لەسەر %@ تێکەڵ کراوە. هیچ شتێک ناچێتە دەرەوە: بێ هەژمار، بێ کڵاود."}}}},
