    "Removed all Apple Health imported data.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "هەموو داتای هاوردەکراوی Apple Health لابرا."}}, "ckb": {"stringUnit": {"state": "translated", "value": "هەموو داتای هاوردەکراوی Apple Health لابرا."}}}},
