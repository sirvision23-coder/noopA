    "Activity Breakdown": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "دابەشکردنی چالاکی"}}, "ckb": {"stringUnit": {"state": "translated", "value": "دابەشکردنی چالاکی"}}}},
