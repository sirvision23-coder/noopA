    "Radio connected, stream not yet trusted.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "ڕادیۆ پەیوەستە، ڕەوەند هێشتا متمانەپێکراو نییە."}}, "ckb": {"stringUnit": {"state": "translated", "value": "ڕادیۆ پەیوەستە، ڕەوەند هێشتا متمانەپێکراو نییە."}}}},
