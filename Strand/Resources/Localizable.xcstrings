    "Logged %lld millilitres at %@": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "%lld میلی‌لیتر لە %@ تۆمار کرا"}}, "ckb": {"stringUnit": {"state": "translated", "value": "%lld میلی‌لیتر لە %@ تۆمار کرا"}}}},
    "Logged as a nap. Wrong? Tap Edit to adjust your sleep and wake times.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "وەک خەوی کورت تۆمار کرا. هەڵەیە؟ دەستی بە «دەستکاریکردن» بنێ بۆ ڕێکخستنی کاتی خەوتن و لەخەوهەستانت."}}, "ckb": {"stringUnit": {"state": "translated", "value": "وەک خەوی کورت تۆمار کرا. هەڵەیە؟ دەستی بە «دەستکاریکردن» بنێ بۆ ڕێکخستنی کاتی خەوتن و لەخەوهەستانت."}}}},
    "Logged bedtime at %@.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "کاتی نوستن لە %@ تۆمار کرا."}}, "ckb": {"stringUnit": {"state": "translated", "value": "کاتی نوستن لە %@ تۆمار کرا."}}}},
    "Logged sessions across %@.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "دانیشتنە تۆمارکراوەکان لە %@."}}, "ckb": {"stringUnit": {"state": "translated", "value": "دانیشتنە تۆمارکراوەکان لە %@."}}}},
    "Logged today": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "ئەمڕۆ تۆمار کرا"}}, "ckb": {"stringUnit": {"state": "translated", "value": "ئەمڕۆ تۆمار کرا"}}}},
    "Logged wake-up at %@.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "لەخەوهەستان لە %@ تۆمار کرا."}}, "ckb": {"stringUnit": {"state": "translated", "value": "لەخەوهەستان لە %@ تۆمار کرا."}}}},
    "Logging ahead for tomorrow: today's activities inform tomorrow's recovery, just as yesterday's are reflected in today's. Tomorrow's answers line up with tomorrow's morning.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "تۆمارکردنی پێشوەخت بۆ سبەینێ: چالاکییەکانی ئەمڕۆ کاریگەری لەسەر چاکبوونەوەی سبەینێ دەکەن، وەک چۆن چالاکییەکانی دوێنێ لە ئەمڕۆدا دەبینرێن. وەڵامەکانی سبەینێ لەگەڵ بەیانیی سبەینێ ڕیز دەبن."}}, "ckb": {"stringUnit": {"state": "translated", "value": "تۆمارکردنی پێشوەخت بۆ سبەینێ: چالاکییەکانی ئەمڕۆ کاریگەری لەسەر چاکبوونەوەی سبەینێ دەکەن، وەک چۆن چالاکییەکانی دوێنێ لە ئەمڕۆدا دەبینرێن. وەڵامەکانی سبەینێ لەگەڵ بەیانیی سبەینێ ڕیز دەبن."}}}},
