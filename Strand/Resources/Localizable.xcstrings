    "Newer WHOOP band, experimental in NOOP": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "بەندی نوێتری WHOOP، لە NOOP دا تاقیکارییە"}}, "ckb": {"stringUnit": {"state": "translated", "value": "بەندی نوێتری WHOOP، لە NOOP دا تاقیکارییە"}}}},
