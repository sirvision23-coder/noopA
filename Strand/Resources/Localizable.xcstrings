    "Extra or skipped beats": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "لێدانی زیادە یان بازدراو"}}, "ckb": {"stringUnit": {"state": "translated", "value": "لێدانی زیادە یان بازدراو"}}}},
