    "Charge is strong and sleep was consistent.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "شەحن بەهێزە و خەو یەکنەواخت بوو."}}, "ckb": {"stringUnit": {"state": "translated", "value": "شەحن بەهێزە و خەو یەکنەواخت بوو."}}}},
