    "Recording status, not shown for a past day": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "دۆخی تۆمارکردن، بۆ ڕۆژێکی ڕابردوو پیشان نادرێت"}}, "ckb": {"stringUnit": {"state": "translated", "value": "دۆخی تۆمارکردن، بۆ ڕۆژێکی ڕابردوو پیشان نادرێت"}}}},
