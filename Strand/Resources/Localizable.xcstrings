    "Charge %lld today, so your band is %lld–%lld bpm.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "شەحن %lld ئەمڕۆ، بۆیە ماوەکەت %lld–%lld لێدان/خولەکە."}}, "ckb": {"stringUnit": {"state": "translated", "value": "شەحن %lld ئەمڕۆ، بۆیە ماوەکەت %lld–%lld لێدان/خولەکە."}}}},
    "Charge (all history)": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "شەحن (هەموو مێژوو)"}}, "ckb": {"stringUnit": {"state": "translated", "value": "شەحن (هەموو مێژوو)"}}}},
    "Charge (past year)": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "شەحن (ساڵی ڕابردوو)"}}, "ckb": {"stringUnit": {"state": "translated", "value": "شەحن (ساڵی ڕابردوو)"}}}},
    "Charge baseline calibrating. %@, %@. %@.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "ئاستی بنەڕەتی شەحن لە ڕێکخستندایە. %@، %@. %@."}}, "ckb": {"stringUnit": {"state": "translated", "value": "ئاستی بنەڕەتی شەحن لە ڕێکخستندایە. %@، %@. %@."}}}},
    "Charge baseline recalibrating": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "ئاستی بنەڕەتی شەحن دووبارە ڕێک دەخرێتەوە"}}, "ckb": {"stringUnit": {"state": "translated", "value": "ئاستی بنەڕەتی شەحن دووبارە ڕێک دەخرێتەوە"}}}},
    "Charge is low and sleep was consistent.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "شەحن کەمە و خەو جێگیر بوو."}}, "ckb": {"stringUnit": {"state": "translated", "value": "شەحن کەمە و خەو جێگیر بوو."}}}},
    "Charge is low but sleep ran short.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "شەحن کەمە و خەوەکەش کورت بوو."}}, "ckb": {"stringUnit": {"state": "translated", "value": "شەحن کەمە و خەوەکەش کورت بوو."}}}},
    "Charge is low.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "شەحن کەمە."}}, "ckb": {"stringUnit": {"state": "translated", "value": "شەحن کەمە."}}}},
    "Charge is steady and sleep was consistent.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "شەحن جێگیرە و خەو یەکنەواخت بوو."}}, "ckb": {"stringUnit": {"state": "translated", "value": "شەحن جێگیرە و خەو یەکنەواخت بوو."}}}},
    "Charge is steady but sleep ran short.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "شەحن جێگیرە بەڵام خەو کورت بوو."}}, "ckb": {"stringUnit": {"state": "translated", "value": "شەحن جێگیرە بەڵام خەو کورت بوو."}}}},
