    "Not a medical device, not medical advice": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "ئامێری پزیشکی نییە، ئامۆژگاریی پزیشکی نییە"}}, "ckb": {"stringUnit": {"state": "translated", "value": "ئامێری پزیشکی نییە، ئامۆژگاریی پزیشکی نییە"}}}},
    "Not a workout": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "ڕاهێنان نییە"}}, "ckb": {"stringUnit": {"state": "translated", "value": "ڕاهێنان نییە"}}}},
    "Not affiliated with, endorsed by, or connected to WHOOP. Interoperability software for hardware you own and your own data. Use it only with a device you own, and not in breach of any agreement that applies to you. Not a medical device.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "سەر بە WHOOP نییە، لەلایەن WHOOP پشتگیری نەکراوە و پەیوەندیی پێیەوە نییە. نەرمەکاڵای هاوکارییە بۆ ئەو هاردوێرەی هی خۆتە و داتای خۆت. تەنیا لەگەڵ ئامێرێک بەکاری بهێنە کە هی خۆتە، و بە پێچەوانەی هیچ ڕێککەوتنێک نەبێت کە لەسەرتە. ئامێری پزیشکی نییە."}}, "ckb": {"stringUnit": {"state": "translated", "value": "سەر بە WHOOP نییە، لەلایەن WHOOP پشتگیری نەکراوە و پەیوەندیی پێیەوە نییە. نەرمەکاڵای هاوکارییە بۆ ئەو هاردوێرەی هی خۆتە و داتای خۆت. تەنیا لەگەڵ ئامێرێک بەکاری بهێنە کە هی خۆتە، و بە پێچەوانەی هیچ ڕێککەوتنێک نەبێت کە لەسەرتە. ئامێری پزیشکی نییە."}}}},
    "Not available": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "بەردەست نییە"}}, "ckb": {"stringUnit": {"state": "translated", "value": "بەردەست نییە"}}}},
