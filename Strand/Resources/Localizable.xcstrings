    "Date of birth": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "ڕێکەوتی لەدایکبوون"}}, "ckb": {"stringUnit": {"state": "translated", "value": "ڕێکەوتی لەدایکبوون"}}}},
