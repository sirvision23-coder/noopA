    "Yes/No": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "بەڵێ/نەخێر"}}, "ckb": {"stringUnit": {"state": "translated", "value": "بەڵێ/نەخێر"}}}},
    "HRV (rMSSD)": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "گۆڕانی لێدانی دڵ (rMSSD)"}}, "ckb": {"stringUnit": {"state": "translated", "value": "گۆڕانی لێدانی دڵ (rMSSD)"}}}},
    "Recovery & strain": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "چاکبوونەوە و فشار"}}, "ckb": {"stringUnit": {"state": "translated", "value": "چاکبوونەوە و فشار"}}}},
    "Stress (on-device)": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "فشاری دەروونی (لەسەر ئامێر)"}}, "ckb": {"stringUnit": {"state": "translated", "value": "فشاری دەروونی (لەسەر ئامێر)"}}}},
    "Workout detection": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "دۆزینەوەی ڕاهێنان"}}, "ckb": {"stringUnit": {"state": "translated", "value": "دۆزینەوەی ڕاهێنان"}}}},
    "Blood oxygen (SpO₂ %)": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "ئۆکسجینی خوێن (SpO₂ %)\n"}}, "ckb": {"stringUnit": {"state": "translated", "value": "ئۆکسجینی خوێن (SpO₂ %)\n"}}}},
