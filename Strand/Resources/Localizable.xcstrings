    "Advanced. I already have my ring's key.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "پێشکەوتوو. پێشتر کلیلی ئەڵقەکەم هەیە."}}, "ckb": {"stringUnit": {"state": "translated", "value": "پێشکەوتوو. پێشتر کلیلی ئەڵقەکەم هەیە."}}}},
