    "Biceps": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "دوو سەری قۆڵ"}}, "ckb": {"stringUnit": {"state": "translated", "value": "دوو سەری قۆڵ"}}}},
    "Forearms": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "بەشی خوارەوەی قۆڵ"}}, "ckb": {"stringUnit": {"state": "translated", "value": "بەشی خوارەوەی قۆڵ"}}}},
