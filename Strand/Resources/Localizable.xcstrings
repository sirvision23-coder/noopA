    "Workout saved · %@": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "ڕاهێنان پاشەکەوت کرا · %@"}}, "ckb": {"stringUnit": {"state": "translated", "value": "ڕاهێنان پاشەکەوت کرا · %@"}}}},
