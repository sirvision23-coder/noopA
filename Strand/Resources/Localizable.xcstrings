    "Move, relative to tonight": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "جووڵە، بەراورد بە ئەمشەو"}}, "ckb": {"stringUnit": {"state": "translated", "value": "جووڵە، بەراورد بە ئەمشەو"}}}},
