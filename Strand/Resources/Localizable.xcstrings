    "Get a notification when the strap battery runs low (15%) so you can top it up before tonight, and when it finishes charging.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "ئاگادارکردنەوەیەک وەربگرە کاتێک باتریی بەند کەم دەبێت (١٥%) بۆ ئەوەی پێش ئەمشەو پڕی بکەیتەوە، و کاتێک شەحنکردنی تەواو دەبێت."}}, "ckb": {"stringUnit": {"state": "translated", "value": "ئاگادارکردنەوەیەک وەربگرە کاتێک باتریی بەند کەم دەبێت (١٥%) بۆ ئەوەی پێش ئەمشەو پڕی بکەیتەوە، و کاتێک شەحنکردنی تەواو دەبێت."}}}},
    "Get in touch": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "پەیوەندیمان پێوە بکە"}}, "ckb": {"stringUnit": {"state": "translated", "value": "پەیوەندیمان پێوە بکە"}}}},
    "Get it ready, then scan.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "ئامادەی بکە، پاشان بگەڕێ."}}, "ckb": {"stringUnit": {"state": "translated", "value": "ئامادەی بکە، پاشان بگەڕێ."}}}},
