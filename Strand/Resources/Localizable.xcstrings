    "Add your Oura app credentials to OuraSecrets.xcconfig to enable this.": {},
    "Adds a fluid log and an effort-adjusted daily goal. Log a sip, cup or bottle to fill your progress ring. Data stays on this device.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Adds a fluid log and an effort-adjusted daily goal. Log a sip, cup or bottle to fill your progress ring. Data stays on this device."}}}},
    "Also imports water from Apple Health when connected and allowed to read water data. Drinks logged in NOOP are not written to Apple Health.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Also imports water from Apple Health when connected and allowed to read water data. Drinks logged in NOOP are not written to Apple Health."}}}},
    "Adds a water-log card to your dashboard": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "کارتی تۆماری ئاو دەخاتە داشبۆردەکەتەوە"}}, "ckb": {"stringUnit": {"state": "translated", "value": "کارتی تۆماری ئاو دەخاتە داشبۆردەکەتەوە"}}}},
