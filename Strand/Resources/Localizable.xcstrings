    "Save & Continue": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "پاشەکەوتکردن و بەردەوامبوون"}}, "ckb": {"stringUnit": {"state": "translated", "value": "پاشەکەوتکردن و بەردەوامبوون"}}}},
    "Save a full backup to a folder you choose - point it at Google Drive, iCloud or Dropbox for off-device sync.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "پاشەکەوتێکی تەواو بۆ بوخچەیەک هەڵبگرە کە خۆت هەڵیدەبژێریت - ئاڕاستەی بکە بۆ Google Drive، iCloud یان Dropbox بۆ هاوکاتکردنی دەرەوەی ئامێر."}}, "ckb": {"stringUnit": {"state": "translated", "value": "پاشەکەوتێکی تەواو بۆ بوخچەیەک هەڵبگرە کە خۆت هەڵیدەبژێریت - ئاڕاستەی بکە بۆ Google Drive، iCloud یان Dropbox بۆ هاوکاتکردنی دەرەوەی ئامێر."}}}},
    "Save it": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "پاشەکەوتی بکە"}}, "ckb": {"stringUnit": {"state": "translated", "value": "پاشەکەوتی بکە"}}}},
