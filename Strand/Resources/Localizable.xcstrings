    "Heart rate %lld bpm, minimum %lld, maximum %lld": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "لێدانی دڵ %lld لێدان/خولەک، کەمترین %lld، زۆرترین %lld"}}, "ckb": {"stringUnit": {"state": "translated", "value": "لێدانی دڵ %lld لێدان/خولەک، کەمترین %lld، زۆرترین %lld"}}}},
