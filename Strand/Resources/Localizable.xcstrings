    "Estimated vs your phone": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "خەمڵێنراو بەرامبەر مۆبایلەکەت"}}, "ckb": {"stringUnit": {"state": "translated", "value": "خەمڵێنراو بەرامبەر مۆبایلەکەت"}}}},
