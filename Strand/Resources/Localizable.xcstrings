    "Check the values and try again.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "بەهاکان بپشکنە و دووبارە هەوڵبدەرەوە."}}, "ckb": {"stringUnit": {"state": "translated", "value": "بەهاکان بپشکنە و دووبارە هەوڵبدەرەوە."}}}},
