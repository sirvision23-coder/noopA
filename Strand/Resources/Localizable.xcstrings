    "Autonomic load from HRV and resting heart rate": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "بارگرانیی دەمارە خۆکارەکان لە گۆڕانی لێدانی دڵ و لێدانی دڵ لە پشوودا"}}, "ckb": {"stringUnit": {"state": "translated", "value": "بارگرانیی دەمارە خۆکارەکان لە گۆڕانی لێدانی دڵ و لێدانی دڵ لە پشوودا"}}}},
