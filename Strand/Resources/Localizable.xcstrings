    "Using NOOP may breach WHOOP's Terms of Service": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "بەکارهێنانی NOOP لەوانەیە مەرجەکانی خزمەتگوزاریی WHOOP بشکێنێت"}}, "ckb": {"stringUnit": {"state": "translated", "value": "بەکارهێنانی NOOP لەوانەیە مەرجەکانی خزمەتگوزاریی WHOOP بشکێنێت"}}}},
