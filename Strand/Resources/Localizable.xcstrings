    "Strap battery, no reading yet": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "باتریی بەند، هێشتا خوێندنەوە نییە"}}, "ckb": {"stringUnit": {"state": "translated", "value": "باتریی بەند، هێشتا خوێندنەوە نییە"}}}},
