    "Lifting log (Hevy / Liftosaur)": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "تۆماری بارهەڵگرتن (Hevy / Liftosaur)"}}, "ckb": {"stringUnit": {"state": "translated", "value": "تۆماری بارهەڵگرتن (Hevy / Liftosaur)"}}}},
