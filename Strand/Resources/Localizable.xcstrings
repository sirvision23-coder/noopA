    "Light + sleep timing only": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "تەنیا ڕووناکی + کاتی خەو"}}, "ckb": {"stringUnit": {"state": "translated", "value": "تەنیا ڕووناکی + کاتی خەو"}}}},
    "Light Sleep": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "خەوی سووک"}}, "ckb": {"stringUnit": {"state": "translated", "value": "خەوی سووک"}}}},
    "Likely your Oura warranty and support, because the ring is no longer paired to Oura. Treat this as permanent.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "زۆرجار گەرەنتی و پشتگیریی Oura، چونکە ئەڵقەکە چیتر لەگەڵ Oura جووت نییە. وەک هەمیشەیی مامەڵەی لەگەڵ بکە."}}, "ckb": {"stringUnit": {"state": "translated", "value": "زۆرجار گەرەنتی و پشتگیریی Oura، چونکە ئەڵقەکە چیتر لەگەڵ Oura جووت نییە. وەک هەمیشەیی مامەڵەی لەگەڵ بکە."}}}},
    "Lining them up…": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "ڕیز دەکرێن…"}}, "ckb": {"stringUnit": {"state": "translated", "value": "ڕیز دەکرێن…"}}}},
    "Liquid Today (prototype)": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "ئەمڕۆی شل (نموونەی سەرەتایی)"}}, "ckb": {"stringUnit": {"state": "translated", "value": "ئەمڕۆی شل (نموونەی سەرەتایی)"}}}},
    "Listening for the strap's reply…": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "گوێ لە وەڵامی بەند دەگیرێت…"}}, "ckb": {"stringUnit": {"state": "translated", "value": "گوێ لە وەڵامی بەند دەگیرێت…"}}}},
