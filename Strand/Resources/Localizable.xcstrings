    "last night": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "شەوی ڕابردوو"}}, "ckb": {"stringUnit": {"state": "translated", "value": "شەوی ڕابردوو"}}}},
    "no data yet": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "هێشتا داتا نییە"}}, "ckb": {"stringUnit": {"state": "translated", "value": "هێشتا داتا نییە"}}}},
    "strap estimate (unverified)": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "خەمڵاندنی بەند (پشتڕاستنەکراو)"}}, "ckb": {"stringUnit": {"state": "translated", "value": "خەمڵاندنی بەند (پشتڕاستنەکراو)"}}}},
