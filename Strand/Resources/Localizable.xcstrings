    "NOOP is connecting to your strap and will sync as soon as it's ready.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "NOOP پەیوەست دەبێت بە بەندەکەت و هەر کە ئامادە بوو هاوکات دەکات."}}, "ckb": {"stringUnit": {"state": "translated", "value": "NOOP پەیوەست دەبێت بە بەندەکەت و هەر کە ئامادە بوو هاوکات دەکات."}}}},
