    "Workout": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "ڕاهێنان"}}, "ckb": {"stringUnit": {"state": "translated", "value": "ڕاهێنان"}}}},
    "Workout file (GPX / TCX / FIT)": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "فایلی ڕاهێنان (GPX / TCX / FIT)"}}, "ckb": {"stringUnit": {"state": "translated", "value": "فایلی ڕاهێنان (GPX / TCX / FIT)"}}}},
