    "Replace all current data with the backup %@? This cannot be undone.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "هەموو داتا ئێستاکان بە پاشەکەوتی %@ بگۆڕدرێن؟ ئەمە ناگەڕێتەوە."}}, "ckb": {"stringUnit": {"state": "translated", "value": "هەموو داتا ئێستاکان بە پاشەکەوتی %@ بگۆڕدرێن؟ ئەمە ناگەڕێتەوە."}}}},
    "Replace all current data with the backup from %@? This cannot be undone.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "هەموو داتا ئێستاکان بە پاشەکەوتی %@ بگۆڕدرێن؟ ئەمە ناگەڕێتەوە."}}, "ckb": {"stringUnit": {"state": "translated", "value": "هەموو داتا ئێستاکان بە پاشەکەوتی %@ بگۆڕدرێن؟ ئەمە ناگەڕێتەوە."}}}},
