    "Paste your %@ API key": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "کلیلی API ی %@ت لێرە دابنێ"}}, "ckb": {"stringUnit": {"state": "translated", "value": "کلیلی API ی %@ت لێرە دابنێ"}}}},
    "Patterns in your own data: association, not cause.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "شێوازەکان لە داتای خۆتدا: پەیوەندی، نەک هۆکار."}}, "ckb": {"stringUnit": {"state": "translated", "value": "شێوازەکان لە داتای خۆتدا: پەیوەندی، نەک هۆکار."}}}},
