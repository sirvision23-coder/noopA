    "Refresh models from provider": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "نوێکردنەوەی مۆدێلەکان لە دابینکەرەوە"}}, "ckb": {"stringUnit": {"state": "translated", "value": "نوێکردنەوەی مۆدێلەکان لە دابینکەرەوە"}}}},
