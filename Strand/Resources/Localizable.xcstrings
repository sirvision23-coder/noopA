    "Tap to edit": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "دەستی پێوە بنێ بۆ دەستکاریکردن"}}, "ckb": {"stringUnit": {"state": "translated", "value": "دەستی پێوە بنێ بۆ دەستکاریکردن"}}}},
