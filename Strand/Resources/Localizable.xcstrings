    "Inactivity reminder": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "یادخەرەوەی نەجوڵان"}}, "ckb": {"stringUnit": {"state": "translated", "value": "یادخەرەوەی نەجوڵان"}}}},
    "Incl. Helio. Live heart rate where the band exposes it. Help us test.": {},
